{
  "name": "moodlia",
  "version": "0.4.0",
  "description": "Command-line and Node client for MoodlIA Moodle automation over REST.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Pablo Gallego",
  "homepage": "https://moodlia.com/products/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gafapa/moodlia-cli.git"
  },
  "bugs": {
    "url": "https://github.com/gafapa/moodlia-cli/issues"
  },
  "main": "./client/moodle-rest-client.mjs",
  "types": "./client/moodle-rest-client.d.ts",
  "sideEffects": false,
  "bin": {
    "moodlia": "cli/moodlia.mjs"
  },
  "exports": {
    ".": {
      "types": "./client/moodle-rest-client.d.ts",
      "import": "./client/moodle-rest-client.mjs"
    },
    "./contract": "./contract/operations.json",
    "./adaptive": {
      "types": "./adaptive/index.d.ts",
      "import": "./adaptive/index.mjs"
    },
    "./adapters/moodlia": {
      "types": "./adapters/moodlia/index.d.ts",
      "import": "./adapters/moodlia/index.mjs"
    },
    "./core": {
      "types": "./core/index.d.ts",
      "import": "./core/index.mjs"
    },
    "./core/profiles": {
      "types": "./core/profiles.d.ts",
      "import": "./core/profiles.mjs"
    },
    "./core/canonical": {
      "types": "./core/canonical.d.ts",
      "import": "./core/canonical.mjs"
    },
    "./core/transport": {
      "types": "./core/transport.d.ts",
      "import": "./core/transport.mjs"
    },
    "./core/cli-options": {
      "types": "./core/cli-options.d.ts",
      "import": "./core/cli-options.mjs"
    },
    "./core/exit-codes": {
      "types": "./core/exit-codes.d.ts",
      "import": "./core/exit-codes.mjs"
    },
    "./core/capabilities": {
      "types": "./core/capabilities.d.ts",
      "import": "./core/capabilities.mjs"
    },
    "./core/adapters": {
      "types": "./core/adapters.d.ts",
      "import": "./core/adapters.mjs"
    },
    "./core/workflows": {
      "types": "./core/workflows.d.ts",
      "import": "./core/workflows.mjs"
    }
  },
  "files": [
    "cli/",
    "core/",
    "client/",
    "adaptive/",
    "adapters/",
    "contract/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "moodle",
    "moodlia",
    "cli",
    "rest",
    "automation"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "types:generate": "node tools/generate-operation-types.mjs",
    "types:check": "node tools/generate-operation-types.mjs --check",
    "check": "node --check cli/moodlia.mjs && node --check cli/runner.mjs && node --check client/moodle-rest-client.mjs && npm run types:check && npm run types:compile && npm test",
    "pack:check": "npm pack --dry-run",
    "types:compile": "tsc --noEmit --skipLibCheck false --moduleResolution nodenext --module nodenext --target es2022 client/moodle-rest-client.d.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=73 --test-coverage-include=cli/** --test-coverage-include=client/*.mjs --test-coverage-include=adaptive/** --test-coverage-include=adapters/** tests/*.test.mjs",
    "contract:check": "node tools/check-plugin-contract.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "moodle-core-cli": "^0.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "moodliaPlugin": {
    "contractRelease": "v0.1.215"
  }
}
